<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="UTF-8">

    <title>Login</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="auth-body">

    <div class="auth-container">

        <h1>Iniciar Sesión</h1>

        <form action="/login" method="POST">

            <input
                type="email"
                name="correo"
                placeholder="Correo electrónico"
                required
            >

            <input
                type="password"
                name="password"
                placeholder="Contraseña"
                required
            >

            <button type="submit">
                Ingresar
            </button>

        </form>

        <p>
            ¿No tienes cuenta?
            <a href="/register">
                Regístrate
            </a>
        </p>

    </div>

</body>
</html>